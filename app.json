{
  "expo": {
    "name": "02_admin_gastos",
    "slug": "02_admin_gastos",
    "scheme": "admingastos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.admingastos.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permite acceder a tus gastos mediante biometría"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite acceder a tus fotos para escanear tickets de compra.",
          "cameraPermission": "Permite usar la cámara para fotografiar y escanear tickets de compra."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1d487b76-752d-4370-9824-96dd41694d70"
      }
    }
  }
}
